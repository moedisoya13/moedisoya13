{
  "source": "https://pypi.org/project/python-barcode/ — colours resolved from PyPI (Warehouse) design tokens at warehouse/static/sass/settings/_colors.scss and blocks/{_banner,_project-header,_site-header}.scss",
  "roles": [
    {"token": "$primary-color",           "hex": "#006dad", "role": "panel base / banner background", "share": "~70% of the header UI area"},
    {"token": "$header-background-color", "hex": "#0073b7", "role": "gradient light stop (lightness +2%)", "share": "site header band"},
    {"token": "adjust($primary-color,-5%)","hex": "#005d93", "role": "install command chip background", "share": "pip instructions box"},
    {"token": "$primary-color-dark",      "hex": "#004d7a", "role": "gradient dark stop (lightness -10%)", "share": "depth / vignette"},
    {"token": "$white",                   "hex": "#ffffff", "role": "title, logo, command text", "share": "~20% (type + logo)"},
    {"token": "$transparent-white",       "hex": "rgba(255,255,255,0.4)", "role": "dotted rules, chip borders", "share": "hairlines"},
    {"token": "$highlight-color",         "hex": "#ffd343", "role": "accent bar / version chip (Python yellow, also in the PyPI logo)", "share": "<2%"}
  ],
  "type": {"display": "Source Sans 3", "mono": "Source Code Pro", "source": "warehouse/static/sass/settings/_fonts.scss"}
}
